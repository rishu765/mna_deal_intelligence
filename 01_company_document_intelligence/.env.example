# Use this file as a reference and export values in your shell.
# The application does not auto-load .env files; never commit real credentials.

OPENAI_API_KEY=
MADI_EMBEDDING_PROVIDER=openai
MADI_EMBEDDING_MODEL=text-embedding-3-small
MADI_EMBEDDING_DIMENSION=1536
MADI_EMBEDDING_BATCH_SIZE=64
MADI_VECTOR_DB_PATH=artifacts/vector_index.sqlite3

MADI_GENERATION_PROVIDER=openai
MADI_GENERATION_MODEL=gpt-6-luna
MADI_GENERATION_REASONING_EFFORT=low
MADI_GENERATION_MAX_OUTPUT_TOKENS=800

# Optional M8 LLM-as-judge settings. The deterministic benchmark does not require these.
MADI_EVALUATION_JUDGE_MODEL=gpt-6-luna
MADI_EVALUATION_JUDGE_REASONING_EFFORT=low

