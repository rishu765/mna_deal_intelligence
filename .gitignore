# Python caches and environments across projects
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Secrets
**/.env
**/.env.*
!**/.env.example

# Local/generated project data
**/data/raw/*
**/data/processed/*
**/artifacts/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
!**/artifacts/.gitkeep

# Coverage, editors, and operating systems
**/.coverage
**/htmlcov/
.idea/
.vscode/
.DS_Store
Thumbs.db

