# Project 2 M2 providers require no secrets. The local dataset and user-supplied providers are
# the only implemented providers. Future provider credentials must stay outside Git.

MATS_DISCOVERY_DATASET_PATH=data/discovery_companies.json
MATS_DISCOVERY_MAX_QUERIES=6
MATS_DISCOVERY_MAX_CANDIDATES_PER_QUERY=10
MATS_DISCOVERY_OVERALL_CANDIDATE_LIMIT=50

# Planned for M3/M5 model-backed capabilities. Project 1 currently uses OPENAI_API_KEY.
# OPENAI_API_KEY=
# MATS_GENERATION_PROVIDER=
# MATS_GENERATION_MODEL=
