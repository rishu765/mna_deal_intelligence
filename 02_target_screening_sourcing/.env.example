# Project 2's bundled M2/M3 providers require no secrets or network access.
# Future provider credentials must stay outside Git.

MATS_DISCOVERY_DATASET_PATH=data/discovery_companies.json
MATS_DISCOVERY_MAX_QUERIES=6
MATS_DISCOVERY_MAX_CANDIDATES_PER_QUERY=10
MATS_DISCOVERY_OVERALL_CANDIDATE_LIMIT=50
MATS_ENRICHMENT_FIXTURE_PATH=data/enrichment_profiles.json
MATS_STRATEGIC_FIT_FIXTURE_PATH=data/strategic_fit_assessments.json

# A separately composed Project 1 client may use its own provider configuration.
# OPENAI_API_KEY=
# Optional model-backed strategic-fit provider configuration.
# MATS_GENERATION_PROVIDER=
# MATS_GENERATION_MODEL=

# LangSmith observability is optional; local execution and tests do not require it.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
